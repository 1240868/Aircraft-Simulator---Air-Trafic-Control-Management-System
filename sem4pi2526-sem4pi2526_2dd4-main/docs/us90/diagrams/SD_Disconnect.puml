@startuml
title US90 — Unexpected Disconnect (design-level sequence diagram)

actor "Pilot Client" as Client
participant ":PilotLoggingClientHandler" as Handler
participant "RemoteAccessCommandObserver" as Observer
participant "RemoteAccessSessionTracker" as Tracker
participant "RemoteAccessUdpLogger" as Logger
participant "RemoteAccessUdpReceiver" as Receiver
participant "RemoteAccessDatagramParser" as Parser
participant "RemoteAccessLogStore" as Store

Client -> Handler: TCP connection closed (no LOGOUT sent)
note right
  e.g. socket error,
  network timeout,
  or client crash
end note

Handler --> Client: (connection lost)
deactivate Handler

group finally block
  Handler -> Observer: observeDisconnect(clientIp, clientPort, logger, tracker)
  activate Observer

  Observer -> Tracker: shouldLogDisconnect()
  activate Tracker

  alt loggedInUsername != null AND !disconnectLogged
    Tracker --> Observer: true
    deactivate Tracker

    Observer -> Tracker: loggedInUsername()
    activate Tracker
    Tracker --> Observer: "pilot1"
    deactivate Tracker

    Observer -> Logger: logDisconnect("pilot1", clientIp, clientPort)
    activate Logger

    Logger -> Logger: "DISCONNECT|2026-06-14T19:00:00Z|\npilot1|192.168.1.10|54321|PILOT"

    Logger -> Logger: send UDP datagram
    deactivate Logger

    Observer -> Tracker: markDisconnectLogged()
    activate Tracker
    Tracker -> Tracker: set disconnectLogged = true
    Tracker --> Observer
    deactivate Tracker
  else
    Tracker --> Observer: false
    note right
      No event emitted:
      session was already
      logged out or never
      authenticated
    end note
    deactivate Tracker
  end

  Observer --> Handler
  deactivate Observer

  Handler -> Handler: socket.close()
end

== Logging Server (dedicated UDP node) ==

Logger -> Receiver : UDP datagram

Receiver -> Parser: parse(payload)
activate Parser
Parser --> Receiver: RemoteAccessLogEntry
deactivate Parser

Receiver -> Store: add(entry)
activate Store
Store -> Store: store event\n   remove session from active sessions
Store --> Receiver
deactivate Store

Receiver -> Receiver: appendToFile(entry)

@enduml
